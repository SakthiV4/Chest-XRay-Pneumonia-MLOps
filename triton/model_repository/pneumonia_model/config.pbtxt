name: pneumonia_model
backend: onnxruntime
max_batch_size: 32

# ── Input tensor ─────────────────────────────────────────────────
input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 3, 224, 224 ]   # CHW — batch dimension is implicit via max_batch_size
  }
]

# ── Output tensor ────────────────────────────────────────────────
output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [ 1 ]             # sigmoid confidence score per sample
  }
]

# ── Instance groups ──────────────────────────────────────────────
instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

# ── Dynamic batching ─────────────────────────────────────────────
dynamic_batching {
  preferred_batch_size: [ 8, 16, 32 ]
  max_queue_delay_microseconds: 50000
}
