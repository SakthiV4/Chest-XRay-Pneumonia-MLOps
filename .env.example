# ── API Keys ──────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git.

# Groq API (Phase 4) - Free tier available at console.groq.com
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama3-8b-8192

# Kaggle credentials (Phase 2 — dataset download)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ── Service URLs ───────────────────────────────────────────────
TRITON_URL=triton:8000                  # Triton HTTP endpoint (docker-compose service name)
BACKEND_URL=http://localhost:8000       # FastAPI backend URL (for local dev)
FRONTEND_PORT=3000                      # React dev server port

# ── Model Settings ─────────────────────────────────────────────
MODEL_NAME=pneumonia_model              # Triton model repository name
MODEL_VERSION=1
CONFIDENCE_THRESHOLD=0.5
